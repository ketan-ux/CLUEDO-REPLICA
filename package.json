{
  "name": "cluedo-replica",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "1920s Noir Cluedo \u2014 real-time multiplayer mystery board game with host-authoritative sync, deduction AI bots, 3D dice physics and procedural Web Audio.",
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "preview": "concurrently -n relay,web -c magenta,cyan \"node tools/supervise.mjs relay\" \"node tools/supervise.mjs web\"",
    "serve:relay": "tsx server/index.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
